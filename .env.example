# WindSight Environment Configuration

# ---------------------------------------------------------------------------
# Backend Configuration
# ---------------------------------------------------------------------------
# Day-ahead decision cutoff hour (UTC)
# 0 = midnight UTC entering delivery date D (24:00 on D-1)
# 1..23 = cutoff hour on day D-1 (e.g. 11 for 11:00 UTC day-ahead gate closure)
DECISION_CUTOFF_HOUR_UTC=0

# Allowed CORS origins (comma-separated list, or * for all)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:80,http://127.0.0.1:80

# Port for FastAPI uvicorn server
PORT=8000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Frontend Configuration
# ---------------------------------------------------------------------------
# Public URL of the backend API (leave empty if using reverse proxy / same-origin in Docker)
VITE_API_URL=http://127.0.0.1:8000
